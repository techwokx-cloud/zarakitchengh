# Copy this file to .env.local for local development.
# Never commit real values -- .env.local is already gitignored.
# On your host, add these under Environment Variables (DirectAdmin's
# Setup Node.js App screen, or Render's Environment tab).

# Supabase (public -- safe for client-side use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase SERVICE ROLE key (SERVER-SIDE ONLY -- never expose to the browser,
# never prefix with NEXT_PUBLIC_). Bypasses Row Level Security. Get it from
# Supabase Dashboard > Settings > API > service_role key.
# Needed for: scheduled/automated jobs (e.g. the monthly report) that run
# with no logged-in user session, and the legacy /api/dashboard/generate-content route.
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase direct Postgres connection (SERVER-SIDE ONLY -- never expose to the browser)
# Used for server actions / API routes that need direct SQL access.
# SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Email sending, via your real cPanel/DirectAdmin mailbox (SMTP) --
# not a third-party service. Used for the monthly/weekly reports.
SMTP_HOST=mail.zarakitchen.online
SMTP_PORT=587
SMTP_USER=orders@zarakitchen.online
SMTP_PASSWORD=your-mailbox-password

# Secret token that authorizes calls to scheduled/cron API routes
# (e.g. /api/reports/monthly?secret=THIS_VALUE). Make this a long random string.
CRON_SECRET=your-long-random-secret

# Baileys WhatsApp bot (deployed on a separate server)
WHATSAPP_BOT_API_URL=https://api.techwokx.online
WHATSAPP_BOT_ADMIN_TOKEN=your-actual-admin-token
