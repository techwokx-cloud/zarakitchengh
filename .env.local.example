# .env.local - Zara Kitchen Dashboard Configuration

# ============================================
# SUPABASE CONFIGURATION
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ============================================
# AI SERVICES API KEYS
# ============================================

# OpenAI (DALL-E 3)
OPENAI_API_KEY=sk-your-openai-key

# FAL AI (Stable Diffusion + json2video)
FAL_AI_KEY=your-fal-ai-key

# Groq (Fast LLM inference)
GROQ_API_KEY=your-groq-api-key

# Google AI (Gemini)
GOOGLE_AI_KEY=your-google-ai-key

# Genspark
GENSPARK_API_KEY=your-genspark-api-key

# Anthropic Claude (Already using via SDK)
ANTHROPIC_API_KEY=sk-your-anthropic-key

# ============================================
# SOCIAL MEDIA INTEGRATION
# ============================================

# Facebook
FACEBOOK_PAGE_ID=your-facebook-page-id
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-page-access-token

# Instagram
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# TikTok
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
TIKTOK_BUSINESS_ACCOUNT_ID=your-tiktok-business-account-id

# Twitter/X
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret

# WhatsApp Business
WHATSAPP_BUSINESS_TOKEN=your-whatsapp-business-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
ZARA_KITCHEN_WHATSAPP=+233243637122

# ============================================
# ZARA KITCHEN BUSINESS INFO
# ============================================

NEXT_PUBLIC_BUSINESS_NAME="Zara Kitchen"
NEXT_PUBLIC_BUSINESS_PHONE=+233243637122
NEXT_PUBLIC_BUSINESS_EMAIL=info@zarakitchengh.com
NEXT_PUBLIC_BUSINESS_ADDRESS="64 Patrice Lumumba St, Accra, Ghana"
NEXT_PUBLIC_BUSINESS_HOURS_OPEN="08:00"
NEXT_PUBLIC_BUSINESS_HOURS_CLOSE="18:00"

# ============================================
# DASHBOARD SETTINGS
# ============================================

NEXT_PUBLIC_DASHBOARD_URL=https://zarakitchengh.com/dashboard
JWT_SECRET=your-super-secret-jwt-key
SESSION_SECRET=your-session-secret

# ============================================
# DEVELOPMENT/PRODUCTION
# ============================================

NEXT_PUBLIC_ENVIRONMENT=development
NODE_ENV=development
